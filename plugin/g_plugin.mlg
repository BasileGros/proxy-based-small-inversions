DECLARE PLUGIN "small-inversion.plugin"

{
open Stdarg


let fresh_env () =
  let env = Global.env () in
  let sigma = Evd.from_env env in
  env, sigma

}

VERNAC COMMAND EXTEND DeriveProxy CLASSIFIED AS SIDEFF STATE opaque_access
| [ "Derive" "InvProxy" "for" ref(ind_ref) ] -> { fun ~opaque_access -> Main.derive_proxy ind_ref false ~opaque_access }
| [ "Derive" "Dependent" "InvProxy" "for" ref(ind_ref) ] -> {fun ~opaque_access -> Main.derive_proxy ind_ref true ~opaque_access }
| [ "Derive" "InvProxy" "for" ref(ind_ref) "with" "prefix" constr(pref) ] ->
  { fun ~opaque_access ->
    let (env, evm) = fresh_env () in
    let (evm, pref) = Constrintern.interp_open_constr env evm pref in
    Main.derive_proxy_prefix ind_ref pref false ~opaque_access
  }
| [ "Derive" "Dependent" "InvProxy" "for" ref(ind_ref) "with" "prefix" constr(pref) ] ->
  { fun ~opaque_access ->
    let (env, evm) = fresh_env () in
    let (evm, pref) = Constrintern.interp_open_constr env evm pref in
    Main.derive_proxy_prefix ind_ref pref true ~opaque_access
  }
END

VERNAC COMMAND EXTEND DeriveOneProxy CLASSIFIED AS SIDEFF STATE opaque_access
| [ "Derive" "InvProxy" "for" ref(ind_ref) "with" "index" constr(n)] ->
  { fun ~opaque_access ->
    let (env, evm) = fresh_env () in
    let (evm, n) = Constrintern.interp_open_constr env evm n in
    Main.derive_one_proxy ind_ref n false ~opaque_access
  }
| [ "Derive" "Dependent" "InvProxy" "for" ref(ind_ref) "with" "index" constr(n)] ->
  { fun ~opaque_access ->
    let (env, evm) = fresh_env () in
    let (evm, n) = Constrintern.interp_open_constr env evm n in
    Main.derive_one_proxy ind_ref n true ~opaque_access }
| [ "Derive" "InvProxy" "for" ref(ind_ref) "with" "index" constr(n) "with" "prefix" constr(pref)] ->
  { fun ~opaque_access ->
    let (env, evm) = fresh_env () in
    let (evm, n) = Constrintern.interp_open_constr env evm n in
    let (evm, pref) = Constrintern.interp_open_constr env evm pref in
    Main.derive_one_proxy_prefix ind_ref n pref false ~opaque_access
  }
| [ "Derive" "Dependent" "InvProxy" "for" ref(ind_ref) "with" "index" constr(n) "with" "prefix" constr(pref)] ->
  { fun ~opaque_access ->
    let (env, evm) = fresh_env () in
    let (evm, n) = Constrintern.interp_open_constr env evm n in
    let (evm, pref) = Constrintern.interp_open_constr env evm pref in
    Main.derive_one_proxy_prefix ind_ref n pref true ~opaque_access}
END

